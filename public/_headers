# Cloudflare önbellek süreleri
# assets: dosya adları her build'de değişir, bir yıl saklanabilir
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Görsel ve video: aynı adla değiştirilirse en geç bir hafta içinde yenilenir
/images/*
  Cache-Control: public, max-age=604800

/videos/*
  Cache-Control: public, max-age=604800

# Ürün verisi kopyası: her yayında yenilenir; sayfa ayrıca veritabanından teyit eder
/data/*
  Cache-Control: public, max-age=300
